        <div id="confirmation-modal" class="modal-overlay fixed inset-0 flex items-center justify-center p-4 hidden z-[102]">
            <div class="modal-content p-6 rounded-lg shadow-2xl w-full max-w-sm relative text-center">
                <h3 id="confirmation-title" class="text-xl font-bold mb-4 text-text-dark"></h3>
                <p id="confirmation-text" class="text-text-muted mb-6"></p>
                <div class="flex justify-center space-x-4">
                    <button id="confirm-cancel-btn" class="btn-secondary px-6 py-2">Cancel</button>
                    <button id="confirm-ok-btn" class="btn-primary px-6 py-2">Confirm</button>
                </div>
