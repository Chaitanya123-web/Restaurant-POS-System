        <div id="message-box-modal" class="modal-overlay fixed inset-0 flex items-center justify-center p-4 hidden z-[101]">
            <div class="modal-content p-6 rounded-lg shadow-2xl w-full max-w-sm relative text-center">
                <h3 id="message-box-title" class="text-xl font-bold mb-4 text-text-dark"></h3>
                <p id="message-box-text" class="text-text-muted mb-6"></p>
                <button id="message-box-ok-btn" class="btn-primary px-8">OK</button>
            </div>
        </div>
    </div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    
    // --- Global State Variables ---
    let menuItems = [];
    let orderHistory = [];
    let workers = [];
    let tableBills = {};
    let activeTableId = 'T1';
    let salesData = { labels: [], data: [] };
    let salesChart = null;
    let paymentModeChart = null;
    let currentCategoryFilter = 'All';

    // --- Define API Base URL ---
    const API_BASE_URL = `${window.location.protocol}//${window.location.host}`;

    // --- Initial Data Fetching ---
    Promise.all([
        fetch(`${API_BASE_URL}/api/menu`).then(res => { if (!res.ok) throw new Error('Menu API failed'); return res.json(); }),
        fetch(`${API_BASE_URL}/api/orders`).then(res => { if (!res.ok) throw new Error('Orders API failed'); return res.json(); }),
        fetch(`${API_BASE_URL}/api/workers`).then(res => { if (!res.ok) throw new Error('Workers API failed'); return res.json(); })
    ]).then(([menuData, orderData, workerData]) => {
        menuItems = menuData;
        orderHistory = orderData;
        workers = workerData;
        initializeApplication();
    }).catch(error => {
        console.error("Fatal Error: Could not fetch initial data from the server.", error);
        showMessageBox("Connection Error", "Could not load data from the server. Please check the server connection and restart.");
    });

    // --- DOM Element References ---
    const itemGrid = document.getElementById('item-grid');
    const billItemsContainer = document.getElementById('bill-items-container');
    const billSubtotalElem = document.getElementById('bill-subtotal');
    const billSgstTaxElem = document.getElementById('bill-sgst-tax');
    const billCgstTaxElem = document.getElementById('bill-cgst-tax');
    const discountInput = document.getElementById('discount-input');
    const billGrandtotalElem = document.getElementById('bill-grandtotal');
    const billPanelTitle = document.getElementById('bill-panel-title');
    const tableSelectionGrid = document.getElementById('table-selection-grid');
    const categoryChipsContainer = document.getElementById('category-chips');
    const itemSearchInput = document.getElementById('item-search');
    const menuTableBody = document.getElementById('menu-table-body');
    const orderHistoryTableBody = document.getElementById('order-history-table-body');
    const workerTableBody = document.getElementById('worker-table-body');
    const generateBillBtn = document.getElementById('generate-bill-btn');
    const printBillBtn = document.getElementById('print-bill-btn');
    const invoiceModal = document.getElementById('invoice-modal');
    
    
    function initializeApplication() {
        renderCategoryChips();
        renderMenuItems(menuItems);
        renderMenuManagementTable();
        renderOrderHistory(orderHistory);
        renderWorkersTable();
        initializeTableBills();
        renderTableSelection();
        selectTable('T1');
    
    }
    
    
    function showMessageBox(title, message) {
        document.getElementById('message-box-title').textContent = title;
        document.getElementById('message-box-text').textContent = message;
        document.getElementById('message-box-modal').classList.remove('hidden');
    }

    let confirmCallback = null;
    function showConfirmationBox(title, message, onConfirm) {
        document.getElementById('confirmation-title').textContent = title;
        document.getElementById('confirmation-text').textContent = message;
        document.getElementById('confirmation-modal').classList.remove('hidden');
        confirmCallback = onConfirm;
    }

    const NUM_TABLES = 12;
    function initializeTableBills() {
        for (let i = 1; i <= NUM_TABLES; i++) {
            tableBills[`T${i}`] = { items: [], discount: '' };
        }
    }

    function renderTableSelection() {
        tableSelectionGrid.innerHTML = '';
        for (let i = 1; i <= NUM_TABLES; i++) {
            const tableId = `T${i}`;
            const tableHasItems = tableBills[tableId].items.length > 0;
            const tableButton = document.createElement('button');
            tableButton.dataset.tableId = tableId;
            let buttonClass = 'p-4 flex flex-col items-center justify-center gap-2 rounded-xl text-sm font-semibold text-gray-800 bg-white border transition-all duration-300 ease-in-out hover:shadow-lg hover:scale-105 ';
            if (activeTableId === tableId) buttonClass += 'border-orange-500 ring-2 ring-orange-300 bg-orange-100 text-orange-600';
            else if (tableHasItems) buttonClass += 'border-red-400 bg-red-100 text-red-700';
            else buttonClass += 'border-gray-300 bg-gray-100 hover:bg-gray-200';
            tableButton.className = buttonClass;
            let content = `<i class="fas fa-utensils text-xl text-orange-500"></i><span>Table ${i}</span>`;
            if (tableHasItems) content = `<span class="text-xs text-white bg-red-500 rounded-full px-2 py-0.5">Active</span>` + content;
            tableButton.innerHTML = content;
            tableButton.addEventListener('click', () => selectTable(tableId));
            tableSelectionGrid.appendChild(tableButton);
        }
    }

    function selectTable(tableId) {
        if(activeTableId) tableBills[activeTableId].discount = discountInput.value;
        activeTableId = tableId;
        discountInput.value = tableBills[activeTableId].discount;
        billPanelTitle.textContent = `Bill for Table ${activeTableId.substring(1)}`;
        updateBillDisplay();
        renderTableSelection();
        filterMenuItems();
    }
    
    function renderCategoryChips() {
        const categories = ['All', ...new Set(menuItems.map(item => item.category))];
        categoryChipsContainer.innerHTML = '';
        categories.forEach(category => {
            const chip = document.createElement('span');
            chip.className = 'chip';
            if (category === currentCategoryFilter) chip.classList.add('active');
            chip.dataset.category = category;
            chip.textContent = category;
            chip.addEventListener('click', (e) => {
                categoryChipsContainer.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
                e.target.classList.add('active');
                currentCategoryFilter = e.target.dataset.category;
                filterMenuItems();
            });
            categoryChipsContainer.appendChild(chip);
        });
    }

    function renderMenuItems(itemsToRender) {
        itemGrid.innerHTML = '';
        itemsToRender.forEach(item => {
            const itemCard = document.createElement('div');
            itemCard.className = 'item-card-wrapper';
            const currentBill = tableBills[activeTableId]?.items || [];
            const itemInBill = currentBill.find(billItem => billItem._id === item._id);
            const currentQtyInBill = itemInBill ? itemInBill.quantity : 0;
            const availabilityOverlay = item.available ? '' : '<div class="item-card-not-available">Not Available</div>';
            const imageUrl = (item.imageUrl && (item.imageUrl.startsWith('http') || item.imageUrl.startsWith('/assets'))) ? item.imageUrl : 'https://placehold.co/400x300/E5E7EB/6B7280?text=No+Image';
            
            itemCard.innerHTML = `
                <div class="item-card-image-container">
                    <img src="${imageUrl}" alt="${item.name}" class="item-card-image" onerror="this.onerror=null;this.src='https://placehold.co/400x300/E5E7EB/6B7280?text=No+Image';">
                    ${availabilityOverlay}
                </div>
                <div class="item-card-details">
                    <h4 class="item-card-name">${item.name}</h4>
                    <p class="item-card-price">₹${item.price.toFixed(2)}</p>
                </div>
                <div class="item-card-controls">
                    ${item.available ? `
                        <div class="item-card-quantity-buttons flex items-center justify-center gap-0.2 py-1">
                            <button class="item-card-qty-btn decrease" data-id="${item._id}">-</button>
                            <span class="px-2 text-text-dark font-medium item-qty-display" data-id="${item._id}">${currentQtyInBill}</span>
                            <button class="item-card-qty-btn increase" data-id="${item._id}">+</button>
                        </div>
                    ` : '<button class="btn-secondary opacity-50 cursor-not-allowed text-xs py-1 px-2">Unavailable</button>'}
                </div>`;
            
            if (item.available) {
                itemCard.querySelectorAll('.item-card-qty-btn').forEach(button => {
                    button.addEventListener('click', (e) => {
                        e.stopPropagation();
                        updateItemQuantityFromCard(button.dataset.id, button.classList.contains('increase') ? 'increase' : 'decrease');
                    });
                });
            }
            itemGrid.appendChild(itemCard);
        });
    }

    function updateItemQuantityFromCard(itemId, action) {
        const itemInMenu = menuItems.find(item => item._id === itemId);
        if (!itemInMenu) return;
        let currentBill = tableBills[activeTableId].items;
        let itemInBill = currentBill.find(billItem => billItem._id === itemId);

        if (action === 'increase') {
            if (itemInBill) itemInBill.quantity++;
            else currentBill.push({ ...itemInMenu, quantity: 1 });
        } else if (action === 'decrease') {
            if (itemInBill) {
                itemInBill.quantity--;
                if (itemInBill.quantity <= 0) {
                    tableBills[activeTableId].items = currentBill.filter(billItem => billItem._id !== itemId);
                }
            }
        } else if (action === 'remove') {
             tableBills[activeTableId].items = currentBill.filter(billItem => billItem._id !== itemId);
        }
        
        updateBillDisplay();
        const itemCardQtyDisplay = document.querySelector(`.item-qty-display[data-id="${itemId}"]`);
        if (itemCardQtyDisplay) {
            const updatedQty = tableBills[activeTableId].items.find(billItem => billItem._id === itemId)?.quantity || 0;
            itemCardQtyDisplay.textContent = updatedQty;
        }
        renderTableSelection();
    }

    function updateBillDisplay() {
        const currentBill = tableBills[activeTableId]?.items || [];
        billItemsContainer.innerHTML = '';
        let subtotal = 0;
        if (currentBill.length === 0) {
            billItemsContainer.innerHTML = '<div class="text-center py-4 text-text-muted">No items added yet.</div>';
        } else {
            currentBill.forEach(item => {
                const itemSubtotal = item.price * item.quantity;
                subtotal += itemSubtotal;
                const itemRow = document.createElement('div');
                itemRow.className = 'flex justify-between items-center py-2 border-b border-gray-400 last:border-b-0 text-sm';
                itemRow.innerHTML = `
                    <div class="w-2/5 font-medium text-text-dark">${item.name}</div>
                    <div class="flex items-center justify-center space-x-2 w-24">
                        <button class="text-red-500 hover:text-red-700 text-lg px-1" data-id="${item._id}" data-action="decrease">-</button>
                        <span class="w-6 text-center text-text-dark">${item.quantity}</span>
                        <button class="text-green-500 hover:text-green-700 text-lg px-1" data-id="${item._id}" data-action="increase">+</button>
                    </div>
                    <div class="w-1/5 text-right text-text-dark">₹${itemSubtotal.toFixed(2)}</div>
                    <button class="text-red-600 hover:text-red-800 ml-2" data-id="${item._id}" data-action="remove">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>`;
                itemRow.querySelectorAll('button').forEach(btn => {
                    btn.addEventListener('click', e => {
                        updateItemQuantityFromCard(e.currentTarget.dataset.id, e.currentTarget.dataset.action);
                    });
                });
                billItemsContainer.appendChild(itemRow);
            });
        }
        
        const SGST_RATE = 0.025;
        const CGST_RATE = 0.025;
        const sgstAmount = subtotal * SGST_RATE;
        const cgstAmount = subtotal * CGST_RATE;
        let discountAmount = 0;
        const discountValue = discountInput.value.trim();
        if (discountValue.endsWith('%')) {
            const percentage = parseFloat(discountValue.replace('%', ''));
            if (!isNaN(percentage)) discountAmount = subtotal * (percentage / 100);
        } else {
            const fixedAmount = parseFloat(discountValue);
            if (!isNaN(fixedAmount)) discountAmount = fixedAmount;
        }
        let grandTotal = subtotal + sgstAmount + cgstAmount - discountAmount;
        billSubtotalElem.textContent = `₹${subtotal.toFixed(2)}`;
        billSgstTaxElem.textContent = `₹${sgstAmount.toFixed(2)}`;
        billCgstTaxElem.textContent = `₹${cgstAmount.toFixed(2)}`;
        billGrandtotalElem.textContent = `₹${Math.max(0, grandTotal).toFixed(2)}`;
    }
    
    discountInput.addEventListener('input', updateBillDisplay);
    itemSearchInput.addEventListener('input', () => {
        currentCategoryFilter = 'All';
        renderCategoryChips();
        filterMenuItems();
    });

    function filterMenuItems() {
        const searchTerm = itemSearchInput.value.toLowerCase();
        const filtered = menuItems.filter(item => {
            const matchesSearch = item.name.toLowerCase().includes(searchTerm);
            const matchesCategory = currentCategoryFilter === 'All' || item.category === currentCategoryFilter;
            return matchesSearch && matchesCategory;
        });
        renderMenuItems(filtered);
    }
    
    // --- Event Listeners for Buttons and Modals ---
    document.getElementById('logout-button').addEventListener('click', () => { window.location.href = '/'; });
    
    const navLinks = document.querySelectorAll('.nav-link');
    const pageSections = document.querySelectorAll('.page-section');
    navLinks.forEach(link => {
        link.addEventListener('click', e => {
            e.preventDefault();
            navLinks.forEach(l => l.classList.remove('active'));
            link.classList.add('active');
            const targetId = link.dataset.section;
            pageSections.forEach(sec => {
                if (sec.id === targetId) {
                    sec.classList.remove('hidden');
                } else {
                    sec.classList.add('hidden');
                }
            });
        });
    });

    // --- Bill Generation Logic ---
    generateBillBtn.addEventListener('click', async () => {
        const currentBillItems = tableBills[activeTableId].items;
        if (currentBillItems.length === 0) {
            showMessageBox('Empty Bill', 'Please add items to the bill before generating.');
            return;
        }

        const subtotal = parseFloat(billSubtotalElem.textContent.replace('₹', ''));
        const sgst = parseFloat(billSgstTaxElem.textContent.replace('₹', ''));
        const cgst = parseFloat(billCgstTaxElem.textContent.replace('₹', ''));
        const grandTotal = parseFloat(billGrandtotalElem.textContent.replace('₹', ''));
        const paymentMode = document.getElementById('payment-mode').value;
        const discountValue = discountInput.value.trim();
        let discountAmount = 0;
        if (discountValue.endsWith('%')) {
            const percentage = parseFloat(discountValue.replace('%', ''));
            if (!isNaN(percentage)) discountAmount = subtotal * (percentage / 100);
        } else {
            const fixedAmount = parseFloat(discountValue);
            if (!isNaN(fixedAmount)) discountAmount = fixedAmount;
        }

        const orderData = {
            billNo: (orderHistory.length + 1).toString().padStart(4, '0'),
            tableNo: parseInt(activeTableId.substring(1)),
            items: currentBillItems.map(item => ({ name: item.name, quantity: item.quantity, price: item.price })),
            subtotal,
            sgst,
            cgst,
            discount: discountAmount,
            grandTotal,
            paymentMode,
        };

        try {
            const response = await fetch(`${API_BASE_URL}/api/orders`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderData),
            });

            if (!response.ok) {
                throw new Error('Failed to save the order.');
            }

            const savedOrder = await response.json();
            orderHistory.unshift(savedOrder);
            renderOrderHistory(orderHistory);
            displayInvoice(savedOrder);

            // Clear the bill for the active table
            tableBills[activeTableId] = { items: [], discount: '' };
            discountInput.value = '';
            updateBillDisplay();
            renderMenuItems(menuItems);
            renderTableSelection();

        } catch (error) {
            console.error('Error generating bill:', error);
            showMessageBox('Error', 'Could not save the order. Please try again.');
        }
    });

    function displayInvoice(order) {
        document.getElementById('invoice-table-no').textContent = order.tableNo;
        document.getElementById('invoice-date').textContent = new Date(order.date).toLocaleString();
        document.getElementById('invoice-bill-no').textContent = order.billNo;
        document.getElementById('invoice-subtotal').textContent = `₹${order.subtotal.toFixed(2)}`;
        document.getElementById('sgstinvoice-tax').textContent = `₹${order.sgst.toFixed(2)}`;
        document.getElementById('cgstinvoice-tax').textContent = `₹${order.cgst.toFixed(2)}`;
        document.getElementById('invoice-discount').textContent = `₹${order.discount.toFixed(2)}`;
        document.getElementById('invoice-grandtotal').textContent = `₹${order.grandTotal.toFixed(2)}`;
        document.getElementById('invoice-payment-mode').textContent = order.paymentMode.toUpperCase();

        const invoiceItemsBody = document.getElementById('invoice-items-body');
        invoiceItemsBody.innerHTML = '';
        order.items.forEach(item => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="text-left py-2 px-1">${item.name}</td>
                <td class="text-center py-2 px-1">${item.quantity}</td>
                <td class="text-center py-2 px-1">₹${item.price.toFixed(2)}</td>
                <td class="text-right py-2 px-1">₹${(item.price * item.quantity).toFixed(2)}</td>
            `;
            invoiceItemsBody.appendChild(row);
        });

        invoiceModal.classList.remove('hidden');
    }

    printBillBtn.addEventListener('click', () => window.print());
    
    // Universal modal close logic
    document.querySelectorAll('.modal-overlay, .close-modal').forEach(el => {
        el.addEventListener('click', (e) => {
            if (e.target === el) {
                el.closest('.modal-overlay').classList.add('hidden');
            }
        });
    });


    // --- Menu Management Logic ---
    function renderMenuManagementTable() {
        menuTableBody.innerHTML = '';
        menuItems.forEach(item => {
            const row = document.createElement('tr');
            row.innerHTML = `
                <td class="py-3 px-6">${item.name}</td>
                <td class="py-3 px-6">${item.category}</td>
                <td class="py-3 px-6 text-right">₹${item.price.toFixed(2)}</td>
                <td class="py-3 px-6 text-center">${item.available ? 'Yes' : 'No'}</td>
                <td class="py-3 px-6 text-center">
                    <button class="text-blue-500">Edit</button>
                    <button class="text-red-500 ml-2">Delete</button>
                </td>
            `;
            menuTableBody.appendChild(row);
        });
    }

    // --- Order History Logic ---
    function renderOrderHistory(orders) {
        orderHistoryTableBody.innerHTML = '';
        orders.forEach(order => {
            const row = document.createElement('tr');
            const orderDate = new Date(order.date).toLocaleDateString();
            row.innerHTML = `
                <td class="py-3 px-6">${orderDate}</td>
                <td class="py-3 px-6">${order.billNo}</td>
                <td class="py-3 px-6 text-right">₹${order.grandTotal.toFixed(2)}</td>
                <td class="py-3 px-6">${order.paymentMode}</td>
                <td class="py-3 px-6 text-center"><button class="text-blue-500">View</button></td>
            `;
            orderHistoryTableBody.appendChild(row);
        });
    }

    // --- Worker Management Logic ---
    function renderWorkersTable() {
        workerTableBody.innerHTML = '';
        workers.forEach(worker => {
            const row = document.createElement('tr');
            const remainingSalary = worker.salary - worker.paidSalary;
            row.innerHTML = `
                <td class="py-3 px-6">${worker.name}</td>
                <td class="py-3 px-6">${worker.role}</td>
                <td class="py-3 px-6 text-right">₹${worker.salary.toFixed(2)}</td>
                <td class="py-3 px-6 text-right">₹${worker.paidSalary.toFixed(2)}</td>
                <td class="py-3 px-6 text-right">₹${remainingSalary.toFixed(2)}</td>
                <td class="py-3 px-6">${worker.contact}</td>
                <td class="py-3 px-6 text-center">
                    <button class="text-blue-500">Edit</button>
                    <button class="text-red-500 ml-2">Delete</button>
                </td>
            `;
            workerTableBody.appendChild(row);
        });
    }

});
</script>
</body>
</html>